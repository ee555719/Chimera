<Window x:Class="Chimera.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Chimera.Host"
        mc:Ignorable="d"
        Title="Chimera" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Navigation -->
            <Border Grid.Column="0" Background="#F0F0F0">
                <StackPanel>
                    <TextBlock Text="Chimera" 
                               FontSize="20" FontWeight="Bold" 
                               Margin="16,16,16,24"
                               HorizontalAlignment="Center"/>

                    <ListView x:Name="NavigationList"
                              SelectionChanged="NavigationList_SelectionChanged"
                              BorderThickness="0"
                              Background="Transparent">
                        <ListViewItem Tag="Plugins" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧩" Margin="0,0,8,0"/>
                                <TextBlock Text="安装插件"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="Shortcuts" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⌨" Margin="0,0,8,0"/>
                                <TextBlock Text="快捷键"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="DevTools" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔧" Margin="0,0,8,0"/>
                                <TextBlock Text="调试器"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="Security" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔒" Margin="0,0,8,0"/>
                                <TextBlock Text="安全"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="About" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ℹ" Margin="0,0,8,0"/>
                                <TextBlock Text="关于"/>
                            </StackPanel>
                        </ListViewItem>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Content Area -->
            <Border Grid.Column="1" Background="White">
                <ContentControl x:Name="ContentArea"/>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="1" Background="#E0E0E0" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="就绪" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="VersionText" VerticalAlignment="Center" Foreground="Gray"/>
            </Grid>
        </Border>
    </Grid>
</Window>
